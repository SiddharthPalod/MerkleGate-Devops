# ==============================================================================
# MerkleGate Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# NEVER commit your actual .env or .pem files to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub App Credentials (Outbound Check Runs)
# ------------------------------------------------------------------------------
# The App ID assigned to your GitHub App in GitHub Developer Settings
GITHUB_APP_ID=1234567

# Path to the RSA private key (.pem) downloaded from your GitHub App settings
GITHUB_APP_PRIVATE_KEY_PATH=./merklegate-privatekey.pem

# ------------------------------------------------------------------------------
# 2. GitHub Webhook Security (Inbound Signature Verification)
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret configured under Webhook Secret in GitHub App settings.
# Used by MerkleGate to verify X-Hub-Signature-256 in constant time.
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret-here

# ------------------------------------------------------------------------------
# 3. Server & Network Endpoints
# ------------------------------------------------------------------------------
# Local port for MerkleGate daemon/visualizer HTTP server
PORT=8083

# Base URL where MerkleGate is reachable
SERVER_URL=http://localhost:8083

# Public webhook forwarder URL (e.g., Smee.io or public ngrok / domain)
WEBHOOK_URL=https://smee.io/your-channel-id

# ------------------------------------------------------------------------------
# 4. Storage Topology (Cold C2SP Disk Tiles & Checkpoint Signers)
# ------------------------------------------------------------------------------
# Directory for cold WORM C2SP static Merkle tree tiles
DATA_DIR=./data

# Directory for Ed25519 Signed Tree Head (STH) private keys and public checkpoints
KEYS_DIR=./data/keys

# ------------------------------------------------------------------------------
# 5. Infrastructure Connections (Hot Search Index & Streaming Queue)
# ------------------------------------------------------------------------------
# Redis 7 Alpine host:port for instant commit and PR metadata search index
REDIS_ADDR=localhost:6379

# Apache Kafka brokers for high-throughput compliance event streaming
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=compliance-events
KAFKA_GROUP=merklegate-daemon
